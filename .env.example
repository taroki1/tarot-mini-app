# =========================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ - ПРИМЕР
# =========================================
# Скопируйте этот файл в .env и заполните реальными значениями
# ВАЖНО: Никогда не коммитьте .env файл в репозиторий!

# =========================================
# НАСТРОЙКИ СЕРВЕРА
# =========================================

# Порт, на котором будет запущен сервер
PORT=3000

# Режим окружения (development, production)
NODE_ENV=development

# =========================================
# DATABASE (PostgreSQL)
# =========================================

# URL для подключения к PostgreSQL базе данных
# Формат: postgresql://username:password@host:port/database
# Пример для локальной разработки:
DATABASE_URL=postgresql://postgres:password@localhost:5432/tarot_app

# Для Beget хостинга используйте предоставленные ими данные:
# DATABASE_URL=postgresql://username:password@host.beget.com:5432/database_name

# =========================================
# TELEGRAM BOT
# =========================================

# Токен вашего Telegram бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# URL вашего Telegram Mini App
# Для разработки: https://yourdomain.com
# Для Beget: https://your-subdomain.beget.tech или ваш домен
TELEGRAM_APP_URL=https://yourdomain.com

# =========================================
# БЕЗОПАСНОСТЬ
# =========================================

# Секретный ключ для JWT токенов (сгенерируйте случайную строку)
# Можно сгенерировать командой: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_change_me

# Секретный ключ для сессий
SESSION_SECRET=your_super_secret_session_key_here_change_me

# =========================================
# АДМИНИСТРАТОР
# =========================================

# Учетные данные администратора по умолчанию
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password_immediately

# Telegram ID администратора (для уведомлений)
# Узнать свой ID можно у бота @userinfobot
ADMIN_TELEGRAM_ID=123456789

# =========================================
# GOOGLE SHEETS (опционально)
# =========================================

# Для интеграции с Google Sheets для импорта тарологов
# Получить через Google Cloud Console: https://console.cloud.google.com

# ID вашей Google таблицы (из URL)
# URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
GOOGLE_SHEETS_ID=your_spreadsheet_id_here

# API ключ Google Sheets
GOOGLE_API_KEY=your_google_api_key_here

# Путь к JSON файлу с учетными данными сервисного аккаунта
GOOGLE_SERVICE_ACCOUNT_PATH=./config/service-account.json

# =========================================
# CORS
# =========================================

# Разрешенные домены для CORS
# Разделяйте запятой для нескольких доменов
ALLOWED_ORIGINS=https://yourdomain.com,https://web.telegram.org

# =========================================
# ФАЙЛОВОЕ ХРАНИЛИЩЕ
# =========================================

# Директория для загрузки файлов (фото тарологов)
UPLOAD_DIR=./uploads

# Максимальный размер загружаемого файла в байтах (5MB)
MAX_FILE_SIZE=5242880

# =========================================
# EMAIL (опционально для уведомлений)
# =========================================

# SMTP настройки для отправки email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password

# Email для получения уведомлений
NOTIFICATION_EMAIL=admin@yourdomain.com

# =========================================
# АНАЛИТИКА (опционально)
# =========================================

# Google Analytics ID
GA_TRACKING_ID=G-XXXXXXXXXX

# Yandex Metrika ID
YM_COUNTER_ID=12345678

# =========================================
# ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ
# =========================================

# Включить подробное логирование
DEBUG=false

# Часовой пояс
TZ=Europe/Moscow

# Язык по умолчанию
DEFAULT_LANGUAGE=ru

# =========================================
# RATE LIMITING
# =========================================

# Максимальное количество запросов в минуту с одного IP
RATE_LIMIT_MAX_REQUESTS=100

# Период для rate limiting (в минутах)
RATE_LIMIT_WINDOW_MS=1

# =========================================
# КЕШИРОВАНИЕ
# =========================================

# Redis URL для кеширования (опционально)
# REDIS_URL=redis://localhost:6379
