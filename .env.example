# =============================================================================
# Tarot Daily Card - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://username:password@localhost:5432/tarot_app

# JWT Secret for Admin Authentication
# Generate a random 32+ character string
JWT_SECRET=your-super-secret-jwt-key-change-this

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password

# Admin Telegram IDs (comma-separated)
# Users with these Telegram IDs will see the Admin tab
ADMIN_TELEGRAM_IDS=123456789,987654321

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# OpenAI API Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Optional: Specify OpenAI model (default: gpt-4-turbo-preview)
OPENAI_MODEL=gpt-4-turbo-preview

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. Database Setup:
#    - Create a PostgreSQL database: createdb tarot_app
#    - Run the schema: psql -d tarot_app -f database_schema.sql
#
# 2. Telegram Bot:
#    - Create a bot with @BotFather
#    - Get the token and add it above
#    - Set the Mini App URL in @BotFather -> Bot Settings -> Menu Button
#
# 3. OpenAI API:
#    - Create an account at https://platform.openai.com
#    - Generate an API key
#    - Add credits to your account for DALL-E 3 image generation
#
# 4. Run the app:
#    - npm install
#    - npm run dev (development)
#    - npm start (production)
#
# =============================================================================
